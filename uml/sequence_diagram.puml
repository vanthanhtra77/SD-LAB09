@startuml SequenceDiagram_TemplateMethod_Lab09
' ==============================================================================
' LAB 09: SƠ ĐỒ TUẦN TỰ (SEQUENCE DIAGRAM)
' NGUYÊN LÝ HOẠT ĐỘNG CỦA MẪU THIẾT KẾ TEMPLATE METHOD
' (Tuân thủ Hollywood Principle: "Don't call us, we'll call you")
' ==============================================================================

skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI", Arial, sans-serif
skinparam sequenceMessageAlign center
skinparam roundcorner 8

actor "Client (Main)" as Client
participant "OrderProcessor\n(Abstract Class)" as Template
participant "ConcreteProcessor\n(Standard / Fragile / Intl)" as Concrete
participant "order : Order" as Order

Client -> Template : processOrder(order)
activate Template #EBF5FB

    == Bước 1: Xác thực đơn hàng (Chung - Invariant) ==
    Template -> Template : validateOrder(order)
    activate Template #D4E6F1
    Template -> Order : getCustomer(), getItems()
    deactivate Template

    == Bước 2: Áp dụng chiết khấu (Chung / Hook) ==
    Template -> Template : applyDiscounts(order)
    activate Template #D4E6F1
    Template -> Order : setDiscountAmount(...)
    deactivate Template

    == Bước 3: Xử lý thanh toán (Biến đổi - Abstract) ==
    Template -> Concrete : processPayment(order)
    activate Concrete #EAFAF1
    Concrete -> Order : setPaymentMethod(...)
    Concrete --> Template : hoàn tất thanh toán
    deactivate Concrete

    == Bước 4: Quy cách đóng gói (Biến đổi - Abstract) ==
    Template -> Concrete : packItems(order)
    activate Concrete #EAFAF1
    Concrete --> Template : hoàn tất đóng gói
    deactivate Concrete

    == Bước 5: Kiểm tra Hook bọc quà ==
    Template -> Template : isGiftWrappingRequired(order)
    opt giftWrapRequested == true
        Template -> Template : wrapGift(order)
    end

    == Bước 6: Nghiệp vụ đặc biệt (Hook - Optional) ==
    Template -> Concrete : performSpecialHandling(order)
    activate Concrete #EAFAF1
    note right of Concrete
      Fragile: Chụp ảnh hiện trạng
      Intl: Làm thủ tục Hải quan
    end note
    Concrete --> Template : hoàn tất
    deactivate Concrete

    == Bước 7: Bàn giao vận chuyển (Biến đổi - Abstract) ==
    Template -> Concrete : shipOrder(order)
    activate Concrete #EAFAF1
    Concrete -> Order : setShippingFee(...), setTrackingCode(...)
    Concrete --> Template : bàn giao thành công
    deactivate Concrete

    == Bước 8: Gửi thông báo khách hàng (Chung - Invariant) ==
    Template -> Template : sendNotification(order)
    activate Template #D4E6F1
    deactivate Template

    == Bước 9: Ghi log kiểm toán (Chung - Invariant) ==
    Template -> Template : recordAuditLog(order)
    activate Template #D4E6F1
    Template -> Order : setStatus("ĐÃ_XUẤT_KHO")
    deactivate Template

Client <-- Template : Hoàn tất đơn hàng
deactivate Template

@enduml
